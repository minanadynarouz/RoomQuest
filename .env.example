# Client environment variables
# Bare origin, no /api suffix. The landing page calls ${VITE_API_BASE_URL}/api/health.
VITE_API_BASE_URL=http://localhost:3000

# API environment variables (copy into apps/api/.env as needed)
PORT=3000
NODE_ENV=development
DIRECTOR_MODE=mock
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
GIT_SHA=dev
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Later tickets (B-06 / B-10); not required to start the API
# DATABASE_URL=postgresql://user:pass@localhost:5432/roomquest
# DIRECT_URL=postgresql://user:pass@localhost:5432/roomquest
# DIRECTOR_MODEL=gemini-3.8-flash
# FALLBACK_MODEL=claude-haiku-4-5
