# Client environment variables
# Bare origin, no /api suffix. The landing page calls ${VITE_API_BASE_URL}/api/health.
#
# VITE_API_BASE_URL — optional for the client · default http://localhost:3000 if unset in Vite
#   environments: local, Vercel Preview (staging API), Vercel Production (prod API)
VITE_API_BASE_URL=http://localhost:3000

# =============================================================================
# API environment variables
# Copy into apps/api/.env as needed. The Nest process boots with none of the
# optional keys set. Do not put real secrets in this file.
#
# Columns in comments: required/optional · default · example · environments
# Full table: docs/api.md § Environment variables
# =============================================================================

# PORT — optional · default 3000 · example 3000
#   environments: local. Render injects PORT at runtime; do not set it in the blueprint.
PORT=3000

# NODE_ENV — optional · default development · example development | test | production
#   environments: local=development, CI/Vitest=test, staging/prod=production
NODE_ENV=development

# DIRECTOR_MODE — optional · default mock · example mock | live
#   environments: local/CI=mock, staging/prod=live
DIRECTOR_MODE=mock

# CORS_ORIGINS — optional · default http://localhost:5173,https://localhost:5173
#   example http://localhost:5173,https://localhost:5173,https://roomquest.vercel.app
#   environments: all (comma-separated extra origins; Vercel previews + https://localhost:* are hardcoded)
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# GIT_SHA — optional · default dev · example deadbeef… (git commit sha)
#   environments: local=dev, staging/prod=deployed commit sha (set by the deploy workflow)
GIT_SHA=dev

# DIRECTOR_MODEL — optional · default gemini-3.8-flash · example gemini-3.8-flash
#   environments: staging/prod; local only when exercising live director
# DIRECTOR_MODEL=gemini-3.8-flash

# DIRECTOR_THINKING — optional · default low · example minimal | low | default
#   environments: staging/prod; Gemini 3 thinkingLevel (LOW default; MINIMAL 400s)
# DIRECTOR_THINKING=low

# DIRECTOR_PLACEMENT — optional · default uv · example uv | slot
# DIRECTOR_PLACEMENT=uv

# GOOGLE_API_KEY — optional · default unset · example (Gemini key; never commit)
#   environments: staging/prod when DIRECTOR_MODE=live; local only for live director tests
# GOOGLE_API_KEY=

# LLM_QUOTA_COOLDOWN_S — optional · default 600 · example 600
#   environments: all. Seconds to skip Gemini after 429 / RESOURCE_EXHAUSTED
#   when the error has no Retry-After / retryDelay.
# LLM_QUOTA_COOLDOWN_S=600

# LLM_REPAIR_MIN_REMAINING_MS — optional · default 3500
#   Skip the LLM repair call unless this much of the LLM window remains.
# LLM_REPAIR_MIN_REMAINING_MS=3500

# DATABASE_URL — optional · default unset · example postgresql://postgres:postgres@localhost:5432/roomquest
#   environments: local Docker Postgres 17 (pooled/runtime). Staging/prod: Neon pooled URL (later; not created here).
#   API boots without it; GET /api/health then reports db:"disabled" and POST /api/v1/levels
#   still serves (no cache, director/procedural only) with a warning. Unreachable URL → db:"down".
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roomquest

# DIRECT_URL — optional · default unset · example postgresql://postgres:postgres@localhost:5432/roomquest
#   environments: local Docker (Prisma CLI / migrate). Staging/prod: Neon unpooled URL (later; not created here).
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/roomquest

# NODE_VERSION — Render build only, not read by Nest · default 22 in render.yaml · example 22
#   environments: staging/prod Render native runtime. Local uses .nvmrc (22).

# Rate limits (B-06) are in-memory in the API process. No Redis / no extra env knobs.
#   60 POST /api/v1/levels per hour per IP (@nestjs/throttler).
#   10 cache misses per hour per X-Device-Id (custom limiter; cache hits do not count).
#   Counters reset on process restart.

# TEST_DATABASE_URL — tests only, not read by Nest · default unset
#   CI: GitHub Actions postgres:17 service. Local: Docker Postgres 17 when running
#   cache integration tests.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roomquest
