<style>
  .panel-root {
    flex-direction: column;
    width: 220px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .heading {
    text-align: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 24px;
    color: #272727;
    width: 100%;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .body {
    color: #272727;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    text-align: center;
    width: 100%;
    margin-top: 10px;
  }

  .body:dark {
    color: rgba(255, 255, 255, 0.9);
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="surveying-title" class="heading">Looking around</div>
    <Divider></Divider>
    <div id="surveying-body" class="body">Reading your room...</div>
  </div>
</Panel>
