<style>
  .panel-root {
    flex-direction: column;
    width: 240px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .heading {
    text-align: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 24px;
    color: #272727;
    width: 100%;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .stars {
    color: #272727;
    font-size: 16px;
    font-weight: 700;
    text-align: center;
    width: 100%;
    margin-top: 10px;
  }

  .stars:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .stats {
    color: #272727;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    width: 100%;
    margin-top: 6px;
  }

  .stats:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .tomorrow {
    color: #272727;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    width: 100%;
    margin-top: 8px;
  }

  .tomorrow:dark {
    color: rgba(255, 255, 255, 0.85);
  }

  .button {
    justify-content: center;
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 10px;
  }

  .button-last {
    justify-content: center;
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 10px;
    margin-bottom: 18px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="win-title" class="heading">You made it</div>
    <Divider></Divider>
    <div id="win-stars" class="stars">1 star</div>
    <div id="win-stats" class="stats">Gems 0 - 0:00</div>
    <div id="win-tomorrow" class="tomorrow">New quest tomorrow</div>
  </div>
  <Button id="win-replay" class="button">
    <ButtonLabel>Replay</ButtonLabel>
  </Button>
  <Button id="win-exit" class="button-last">
    <ButtonLabel>Exit</ButtonLabel>
  </Button>
</Panel>
