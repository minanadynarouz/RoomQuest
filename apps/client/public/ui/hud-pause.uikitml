<style>
  .panel-root {
    flex-direction: column;
    width: 220px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 16px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .heading {
    text-align: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 24px;
    color: #272727;
    width: 100%;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: center;
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 10px;
  }

  .button-last {
    justify-content: center;
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 10px;
    margin-bottom: 18px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="pause-title" class="heading">Paused</div>
    <Divider></Divider>
  </div>
  <Button id="pause-resume" class="button">
    <ButtonLabel>Resume</ButtonLabel>
  </Button>
  <Button id="pause-restart" class="button">
    <ButtonLabel>Restart</ButtonLabel>
  </Button>
  <Button id="pause-exit" class="button-last">
    <ButtonLabel>Exit</ButtonLabel>
  </Button>
</Panel>
