    margin-bottom: 18px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="no-surfaces-title" class="heading">Need more space</div>
    <Divider></Divider>
    <div id="no-surfaces-body" class="body">
      Set up your space in settings, then Retry.
    </div>
  </div>
  <Button id="no-surfaces-retry" class="button">
