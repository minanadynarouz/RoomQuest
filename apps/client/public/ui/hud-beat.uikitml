<style>
  .panel-root {
    flex-direction: column;
    width: 200px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .beat-label {
    color: #272727;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    width: 100%;
  }

  .beat-label:dark {
    color: rgba(255, 255, 255, 0.8);
  }

  .goal {
    color: #272727;
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    text-align: center;
    width: 100%;
    margin-top: 6px;
  }

  .goal:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: center;
    margin-left: 16px;
    margin-right: 16px;
    margin-top: 10px;
    margin-bottom: 12px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div id="beat-label" class="beat-label">Beat 1 of 1</div>
    <div id="beat-goal" class="goal">Help the explorer onward</div>
  </div>
  <Button id="beat-pause" class="button">
    <ButtonLabel>Pause</ButtonLabel>
  </Button>
</Panel>
