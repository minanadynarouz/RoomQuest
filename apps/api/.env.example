# API environment variables (apps/api). Copy to apps/api/.env as needed.
# The Nest process boots with none of the optional keys set. No secrets here.
# Full table: docs/api.md § Environment variables
#
# Each variable: required/optional · default · example · environments

# PORT — optional · default 3000 · example 3000
#   environments: local. Render injects PORT at runtime.
PORT=3000

# NODE_ENV — optional · default development · example development | test | production
#   environments: local=development, CI/Vitest=test, staging/prod=production
NODE_ENV=development

# DIRECTOR_MODE — optional · default mock · example mock | live
#   environments: local/CI=mock, staging/prod=live
DIRECTOR_MODE=mock

# CORS_ORIGINS — optional · default http://localhost:5173,https://localhost:5173
#   example http://localhost:5173,https://localhost:5173,https://roomquest.vercel.app
#   environments: all
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# GIT_SHA — optional · default dev · example deadbeef… (git commit sha)
#   environments: local=dev, staging/prod=deployed commit sha
GIT_SHA=dev

# DIRECTOR_MODEL — optional · default gemini-3.8-flash · example gemini-3.8-flash
#   environments: staging/prod; local only when exercising live director
# DIRECTOR_MODEL=gemini-3.8-flash

# DIRECTOR_THINKING — optional · default low · example minimal | low | default
#   environments: staging/prod; Gemini 3 thinkingLevel (LOW default; MINIMAL 400s)
# DIRECTOR_THINKING=low

# DIRECTOR_DECORATION_THINKING — optional · default minimal · example minimal | low | default
#   environments: staging/prod; thinkingLevel for the DIRECTOR_PLACEMENT=route decoration call only
#   (latency). If Gemini rejects MINIMAL it steps up to LOW (remembered process-wide).
# DIRECTOR_DECORATION_THINKING=minimal

# DIRECTOR_HEDGE_MS — optional · default 3000 · example 3000 | 0
#   environments: staging/prod; DIRECTOR_PLACEMENT=route only. If the decoration call has not
#   returned after this many ms, fire one identical hedge call (same overall deadline, no
#   extension); first usable answer wins, the other is aborted. 0 disables. Each call takes
#   one LLM_DAILY_MAX slot; the hedge is skipped at >= 80% of the cap or while the quota
#   breaker is open.
# DIRECTOR_HEDGE_MS=3000

# DIRECTOR_PLACEMENT — optional · default uv · example uv | slot | route
#   environments: staging/prod; slot = Gemini picks hinted slot ids, server resolves to surface+u+v
# DIRECTOR_PLACEMENT=uv

# LLM_REPAIR_MIN_REMAINING_MS — optional · default 3500 · example 3500
#   environments: staging/prod; skip the 2nd (LLM repair) Gemini call below this remaining budget
# LLM_REPAIR_MIN_REMAINING_MS=3500

# GOOGLE_API_KEY — optional · default unset · example (Gemini key; never commit)
#   environments: staging/prod when DIRECTOR_MODE=live
# GOOGLE_API_KEY=

# LLM_QUOTA_COOLDOWN_S — optional · default 600 · example 600
#   environments: all. Seconds to skip Gemini after 429 / RESOURCE_EXHAUSTED
#   when the error has no Retry-After / retryDelay.
# LLM_QUOTA_COOLDOWN_S=600

# LLM_DAILY_MAX — optional · default 150 · example 150
#   environments: all. Global UTC daily cap on live Gemini calls. Cache hits
#   do not count. Exceeding the cap (or a down/disabled database) skips Gemini
#   and returns fallbackReason:"llm-quota". Health reports llmToday {used,max}.
# LLM_DAILY_MAX=150

# DATABASE_URL — optional · default unset · example postgresql://postgres:postgres@localhost:5432/roomquest
#   environments: local Docker Postgres 17. Staging/prod: Neon pooled URL (not created here).
#   API boots without it; GET /api/health then reports db:"disabled" and POST /api/v1/levels
#   still serves (no cache) with a warning. Unreachable URL → db:"down".
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roomquest

# DIRECT_URL — optional · default unset · example postgresql://postgres:postgres@localhost:5432/roomquest
#   environments: local Docker (Prisma migrate). Staging/prod: Neon unpooled URL (not created in B-10).
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/roomquest

# NODE_VERSION — Render build only, not read by Nest · default 22 in render.yaml · example 22
#   environments: staging/prod Render native runtime. Local uses .nvmrc (22).

# Rate limits (B-06) are in-memory. No extra env knobs.
#   60 POST /api/v1/levels per hour per IP; 10 cache misses per hour per X-Device-Id.

# TEST_DATABASE_URL — tests only, not read by Nest
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roomquest
