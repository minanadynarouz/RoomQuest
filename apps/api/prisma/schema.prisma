// Roomquest API — Prisma 7. LevelCache is the daily director cache (B-06).
// SessionResult is written by POST /api/v1/levels/:cacheKey/result (B-09).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Cached director/procedural plan. PK is sha256(roomHash|date|tier|promptVersion)
/// truncated to 16 hex chars (architecture §6).
model LevelCache {
  key           String   @id
  roomHash      String
  date          String
  tier          String
  promptVersion String
  plan          Json
  source        String
  model         String?
  createdAt     DateTime @default(now())
  results       SessionResult[]
}

/// Anonymous session result (written by B-09). FK keeps results attached to
/// the cached plan that was played.
model SessionResult {
  id         String     @id @default(cuid())
  cacheKey   String
  cache      LevelCache @relation(fields: [cacheKey], references: [key], onDelete: Restrict, onUpdate: Cascade)
  deviceId   String
  stars      Int
  gems       Int
  timeMs     Int
  completed  Boolean
  planSource String
  createdAt  DateTime   @default(now())
}
