// Roomquest API — Prisma 7. LevelCache is the daily director cache (B-06).
// SessionResult is written by POST /api/v1/levels/:cacheKey/result (B-09).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Cached director/procedural plan. PK is sha256(roomHash|date|tier|promptVersion)
/// truncated to 16 hex chars (architecture §6).
model LevelCache {
  key           String   @id
  roomHash      String
  date          String
  tier          String
  promptVersion String
  plan          Json
  source        String
  model         String?
  createdAt     DateTime @default(now())
  results       SessionResult[]
}

/// Anonymous session result (written by B-09). `levelKey` is whatever key
/// the client posted (director cache hash or `proc:<seed>:<tier>`).
/// `cacheKey` is set only for real LevelCache rows; null for proc keys.
model SessionResult {
  id         String      @id @default(cuid())
  levelKey   String
  cacheKey   String?
  cache      LevelCache? @relation(fields: [cacheKey], references: [key], onDelete: Restrict, onUpdate: Cascade)
  deviceId   String
  stars      Int
  gems       Int
  timeMs     Int
  completed  Boolean
  planSource String
  createdAt  DateTime    @default(now())

  @@index([levelKey])
}

/// UTC daily counter of live Gemini calls. Incremented atomically before
/// each live invoke; cache hits do not write a row.
model LlmDailyUsage {
  day   DateTime @id @db.Date
  count Int
}
